# Export through your secret manager/shell before boot; this app does not load dotenv.
LUNIXI_BASE_URL=https://api-gateway.lunixi.com
LUNIXI_KEY_ID=
LUNIXI_MERCHANT_ID=
LUNIXI_PRIVATE_KEY_PATH=/run/secrets/lunixi-private.pem
LUNIXI_WEBHOOK_SECRET=
PUBLIC_ORIGIN=https://merchant.example
# embedded (default) or hosted; existing attempts retain their saved presentation.
LUNIXI_CHECKOUT_MODE=embedded
# Optional comma-separated exact HTTPS origins approved for provider/legacy POSTs.
# Gateway origin above is always included; no paths, wildcards, query or credentials.
LUNIXI_FORM_ACTION_ORIGINS=
DEMO_USERNAME=merchant
DEMO_PASSWORD=
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
